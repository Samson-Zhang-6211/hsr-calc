        "skill_list": [
          {
            "id": 405201201,
            "skill_name": "Undine's Fluttering Hem",
            "skill_desc": "Deals minor Ice DMG to all targets. When in the \"<u>Revel in Destruction</u>\" state, inflicts \"<u>Black Tide Fever</u>\" on the targets attacked, causing some DMG dealt to be taken in the form of DoT over a certain number of turns.",
            "damage_type": "Ice",
            "sp_hit_base": 10,
            "extra": {
              "405301001": {
                "name": "Revel in Destruction",
                "desc": "Number of hits to advance action decreases. When taking DMG or using certain abilities to deal DMG, some DMG will be taken in the form of \"Black Tide Fever\" over a specific number of turns. When the \"Revel in Destruction\" countdown's turn begins, all enemy units will have their \"Revel in Destruction\" state dispelled.",
                "param": []
              },
              "405301002": {
                "name": "Black Tide Fever",
                "desc": "\"Black Tide Fever\" is a type of DoT debuff. The DoT originates from a part of the DMG that the target takes. When stacked, it resets the duration of \"Black Tide Fever.\" In \"Black Tide Fever,\" targets receive Wind Shear, Burn, Shock, and Bleed DoT at the start of their turns. The enemies' \"Black Tide Fever\" is immediately dispelled when the \"Revel in Destruction\" state ends. Allies' \"Black Tide Fever\" is immediately dispelled when their HP is fully restored. The targets will not take the DoT damage after this state is dispelled.",
                "param": []
              }
            }
          },
          {
            "id": 405201202,
            "skill_name": "River of Souls' Intolerable Solitude",
            "skill_desc": "When receiving a killing blow, deals Ice DMG to all friendly units.",
            "damage_type": "Ice",
            "sp_hit_base": "",
            "extra": {}
          },
          {
            "id": 405201203,
            "skill_name": "Respite By The Waters",
            "skill_desc": "Advances action after taking a certain number of attacks from Basic ATK, Skill, Ultimate, or Memosprite Skill. When in the \"<u>Revel in Destruction</u>\" state, decreases the number of attacks required to advance action.",
            "damage_type": "",
            "sp_hit_base": "",
