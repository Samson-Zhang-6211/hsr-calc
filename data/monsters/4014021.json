          {
            "id": 401402103,
            "skill_name": "天谴降，皆奠纷争昂藏",
            "skill_desc": "控制【兵戈扰攘的常胜军】对我方全体造成大量虚数属性伤害。场上每有一个【被征服者】的<u>【百炼战甲】</u>未被破坏，则该技能的伤害倍率提高。",
            "damage_type": "Imaginary",
            "sp_hit_base": 20,
            "extra": {
              "240140134": {
                "name": "百炼战甲",
                "desc": "受到的伤害降低。受到攻击后根据攻击者的【荣耀】层数减少自身【百炼战甲】，减少到0层时，【百炼战甲】被破坏，对自身造成大量虚数属性伤害，削减自身大量韧性，并使自身行动延后，使我方恢复战技点，并使攻击者获得一定层数的【荣耀】。【百炼战甲】被破坏后，自身受到攻击时额外再受到少量虚数属性伤害。【百炼战甲】在自身回合结束时如果层数为0，则恢复到最大层数。",
                "param": []
              }
            }
          },
          {
