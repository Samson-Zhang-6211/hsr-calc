            "skill_name": "BHF: Fiery Advance",
            "skill_desc": "Deals minor Fire DMG to a single target and locks on to the target. In the next action, uses DHGDR: Fire and Cinders on the locked on target.",
            "damage_type": "Fire",
            "sp_hit_base": 10,
