          {
            "id": 501305203,
            "skill_name": "破晓意志",
            "skill_desc": "为自身和其余破晓战队成员附加【破晓力场】。此状态下，破晓战队会免疫自身属性的伤害并持续施放【破晓剑影舞】，同时免疫控制类负面状态，自身的韧性无法被削减。当破晓战队处于【破晓力场】状态时，受到一定次数的攻击后会施放【破晓退散】，若攻击造成了<u>欢愉伤害</u>，则本次攻击改为增加<unbreak>#3[i]</unbreak>点计数。",
            "damage_type": "",
            "sp_hit_base": "",
            "extra": {
              "10000028": {
                "name": "欢愉伤害",
                "desc": "计入的笑点越多，欢愉度、角色等级越高，则造成的欢愉伤害越高。\\n欢愉伤害不受伤害提高类效果所影响。",
                "param": []
              }
            }
          },
          {
            "id": 501305204,
            "skill_name": "破晓剑影舞",
            "skill_desc": "对指定我方单体造成大量火属性伤害。",
            "damage_type": "Fire",
            "sp_hit_base": 10,
            "extra": {}
          },
          {
            "id": 501305205,
            "skill_name": "破晓退散",
            "skill_desc": "解除【破晓力场】，损失一定生命值并为自身附加【失意】，受到的伤害提高，且自身火属性抗性降低。",
            "damage_type": "",
            "sp_hit_base": 10,
