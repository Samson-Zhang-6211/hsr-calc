  "en": {
    "id": 5013052,
    "name": "Daybreak Squadron: Blazeweaver",
    "desc": "The Captain of the Daybreak Squadron. An irrepressible optimist capable of ignoring any cloud of gloom, and a total, happy-go-lucky hot-blooded idiot.\\n\"A '1% success rate' is nothing but numbers on a page! We'll just bridge the gap with courage, friendship, and pure willpower!\"\\nSoul forged in fire! Scorching the darkness! The star that sets the fields ablaze — Blazeweaver Warrior!\\nDarkness wanes, and dawn awakens! The Daybreak Squadron arises!",
    "monster_camp_id": 17,
    "attack_base": 15,
    "critical_damage_base": 0.2,
    "defence_base": 210,
    "hp_base": 6045,
    "initial_delay_ratio": 1,
