  "en": {
    "id": 5013070,
    "name": "Daybreak Squadron: Cinderborne",
    "desc": "The youngest member of the group, a model citizen who perfectly embodies the school conduct code and looks to the future with starry-eyed optimism. Yet, beneath his earnestness lies a trace of shyness and self-doubt. When something piques his interest, he erupts with a manic enthusiasm only to be overcome with mortification afterward for being a nuisance.\\n\"It's a promise, then. You protect the universe, and we'll protect Planarcadia.\"\\nCleaving through despair! A blade as sharp as steel! The undying edge — Cinderborne Warrior!\\nDarkness wanes, and dawn awakens! The Daybreak Squadron arises!",
    "monster_camp_id": 17,
    "attack_base": 18,
    "critical_damage_base": 0.2,
    "defence_base": 210,
    "hp_base": 1395,
    "initial_delay_ratio": 1,
