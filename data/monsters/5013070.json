            "id": 501307001,
            "skill_name": "Daybreak Blade",
            "skill_desc": "Deals Physical DMG to one designated target.",
            "damage_type": "Physical",
            "sp_hit_base": 10,
            "extra": {}
          },
          {
            "id": 501307002,
            "skill_name": "Daybreak Flywheel",
            "skill_desc": "Deals Physical DMG to one designated target and adjacent targets.",
            "damage_type": "Physical",
            "sp_hit_base": 5,
            "extra": {}
          },
          {
            "id": 501307003,
            "skill_name": "Daybreak Will",
            "skill_desc": "Applies \"Daybreak Forcefield\" to this unit. While in this state, Daybreak Squadron continuously uses \"Shadow Dance of the Daybreak Blade,\" and is immune to Crowd Control debuffs. This unit's Toughness cannot be reduced. When this unit is attacked by a Physical-Type attack, it will immediately take action. When Daybreak Squadron is in the \"Daybreak Forcefield\" state, after being attacked a certain number of times, it will use \"Daybreak Dispersal.\"",
            "damage_type": "",
            "sp_hit_base": "",
            "extra": {}
          },
          {
            "id": 501307004,
            "skill_name": "Shadow Dance of the Daybreak Blade",
            "skill_desc": "Deals massive Physical DMG to one designated target.",
            "damage_type": "Physical",
            "sp_hit_base": 10,
            "extra": {}
          },
          {
            "id": 501307005,
            "skill_name": "Daybreak Dispersal",
            "skill_desc": "Dispels \"Daybreak Forcefield\" and applies \"Disheartened\" to this unit, increasing DMG taken and reducing this unit's Physical RES.",
            "damage_type": "",
            "sp_hit_base": 10,
            "extra": {}
          }
