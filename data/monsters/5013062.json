        "skill_list": [
          {
            "id": 501306201,
            "skill_name": "Daybreak Blade",
            "skill_desc": "Deals Imaginary DMG to one designated target.",
            "damage_type": "Imaginary",
            "sp_hit_base": 10,
            "extra": {}
          },
          {
            "id": 501306202,
            "skill_name": "Daybreak Flywheel",
            "skill_desc": "Deals Imaginary DMG to one designated target and adjacent targets.",
            "damage_type": "Imaginary",
            "sp_hit_base": 5,
            "extra": {}
          },
          {
            "id": 501306203,
            "skill_name": "Daybreak Will",
            "skill_desc": "Applies \"Daybreak Forcefield\" to this unit. While in this state, Daybreak Squadron is immune to DMG of its own Type and continuously uses \"Shadow Dance of the Daybreak Blade.\" It is also immune to Crowd Control debuffs, and its Toughness cannot be reduced. When Daybreak Squadron is in the \"Daybreak Forcefield\" state, it uses \"Daybreak Dispersal\" after being attacked a certain number of times. If an attack deals <u>Elation DMG</u>, that attack instead increases the tally by <unbreak>#3[i]</unbreak>.",
            "damage_type": "",
            "sp_hit_base": "",
            "extra": {
              "10000028": {
                "name": "Elation DMG",
                "desc": "The more Punchline taken into account, and the higher the Elation and Character Level, the greater the Elation DMG dealt.\\nElation DMG is not affected by DMG Boost effects.",
                "param": []
              }
            }
          },
          {
            "id": 501306204,
            "skill_name": "Shadow Dance of the Daybreak Blade",
            "skill_desc": "Deals massive Imaginary DMG to one designated target.",
            "damage_type": "Imaginary",
            "sp_hit_base": 10,
            "extra": {}
          },
          {
            "id": 501306205,
            "skill_name": "Daybreak Dispersal",
            "skill_desc": "Dispels \"Daybreak Forcefield,\" loses a certain amount of HP, and applies \"Disheartened\" to this unit, increasing DMG taken and reducing this unit's Imaginary RES.",
            "damage_type": "",
            "sp_hit_base": 10,
            "extra": {}
          }
        ]
      }
    ],
