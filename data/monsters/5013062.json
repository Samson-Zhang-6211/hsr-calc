            "sp_hit_base": "",
            "extra": {
              "10000028": {
                "name": "欢愉伤害",
                "desc": "计入的笑点越多，欢愉度、角色等级越高，则造成的欢愉伤害越高。\\n欢愉伤害不受伤害提高类效果所影响。",
                "param": []
              }
            }
          },
          {
            "id": 501306204,
            "skill_name": "破晓剑影舞",
            "skill_desc": "对指定我方单体造成大量虚数属性伤害。",
            "damage_type": "Imaginary",
            "sp_hit_base": 10,
            "extra": {}
          },
          {
            "id": 501306205,
            "skill_name": "破晓退散",
            "skill_desc": "解除【破晓力场】，损失一定生命值并为自身附加【失意】，受到的伤害提高，且自身虚数属性抗性降低。",
            "damage_type": "",
            "sp_hit_base": 10,
