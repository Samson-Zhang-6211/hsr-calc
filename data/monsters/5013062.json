  "en": {
    "id": 5013062,
    "name": "Daybreak Squadron: Dawnlance",
    "desc": "A flamboyant warrior and the eldest of the group, though not the brightest. She sees herself as the team's guardian but always ends up as the comic relief.\\n\"Look, I did say I'd protect you from the creepy-crawlies, but isn't this one a bit... excessively massive!? STAY AWAY FROM ME, KYAAAAA!!!\"\\nDispelling the eternal night! A radiance like a blazing torch! The shining prayer — Dawnlance Warrior!\\nDarkness wanes, and dawn awakens! The Daybreak Squadron arises!",
    "monster_camp_id": 17,
    "attack_base": 15,
    "critical_damage_base": 0.2,
    "defence_base": 210,
    "hp_base": 5115,
    "initial_delay_ratio": 1,
