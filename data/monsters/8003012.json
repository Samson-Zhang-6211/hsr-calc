            "sp_hit_base": 10,
            "extra": {}
          },
          {
            "id": 800301202,
            "skill_name": "Crystalline Condensation",
            "skill_desc": "Enters the Freezing Point state. Everwinter Rain can be used in subsequent attacks and grants the character 1 stack of Crystallite.",
            "damage_type": "Ice",
            "sp_hit_base": "",
            "extra": {}
          },
          {
            "id": 800301203,
            "skill_name": "Everwinter Rain",
            "skill_desc": "The ability will only be used when in the Freezing Point state. Casting the ability to deal Ice DMG to all targets, with a chance to Freeze the targets and delay their actions.",
            "damage_type": "Ice",
            "sp_hit_base": 15,
            "extra": {}
          },
          {
